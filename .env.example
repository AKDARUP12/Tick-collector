# Arrow — copy to .env and fill in ALL values from https://app.arrow.trade (Developer Apps)
# Never commit the real .env. Rotate the app secret if it was ever exposed.
ARROW_APP_ID=your_app_id
ARROW_APP_SECRET=your_64_hex_char_app_secret
ARROW_TOTP_SECRET=your_totp_seed_base32
ARROW_USER_ID=YOUR_UCC
ARROW_PASSWORD=your_actual_arrow_password
# 4 strikes = 8 legs + spot (default, tight). 5 = 10 legs ATM±200 symmetric — set to 5 if you want no bias.
ARROW_STRIKES=4
ARROW_MODE=full
ARROW_USE_HFT=1
